{
  "name": "sce-pay",
  "version": "0.2.0",
  "private": true,
  "description": "Cloudflare-native, fail-closed automation for paying an SCE bill by card.",
  "type": "module",
  "bin": {
    "sce-pay": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "sce-pay": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts setup",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260723.1",
    "@types/node": "26.1.1",
    "playwright-core": "1.61.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "4.113.0"
  }
}
