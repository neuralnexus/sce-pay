{
  "name": "sce-pay",
  "version": "0.3.0",
  "private": true,
  "description": "Cloudflare-native, fail-closed automation for paying an SCE bill by card.",
  "type": "module",
  "bin": {
    "sce-pay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "wrangler.jsonc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "sce-pay": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts setup",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "validate": "npm run check && npm run build && wrangler deploy --dry-run --outdir .wrangler-dry-run && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@cloudflare/playwright": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "5.20260727.1",
    "@types/node": "26.1.2",
    "playwright-core": "1.62.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "4.114.0"
  }
}
