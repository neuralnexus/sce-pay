{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sce-pay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYMENT_ACCOUNT",
        "class_name": "PaymentAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PaymentAccount"]
    }
  ],
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
